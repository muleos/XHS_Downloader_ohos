{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "srcEntry": "./ets/entryability/XhsAbilityStage.ets",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:perm_internet_reason"
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:perm_pasteboard_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:perm_background_reason"
      },
      {
        "name": "ohos.permission.READ_IMAGEVIDEO",
        "reason": "$string:perm_media_read_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:perm_media_save_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_desc",
        "icon": "$media:startIcon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          {
            "actions": ["ohos.want.action.sendData"],
            "uris": [
              { "scheme": "file", "utd": "general.text" },
              { "scheme": "file", "utd": "general.plain-text" },
              { "scheme": "file", "utd": "general.hyperlink" }
            ]
          },
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              { "scheme": "https", "host": "xiaohongshu.com" },
              { "scheme": "https", "host": "www.xiaohongshu.com" },
              { "scheme": "https", "host": "xhslink.com" },
              { "scheme": "https", "host": "xhslink.cn" },
              { "scheme": "https", "host": "rednote.com" },
              { "scheme": "https", "host": "douyin.com" },
              { "scheme": "https", "host": "www.douyin.com" },
              { "scheme": "https", "host": "v.douyin.com" },
              { "scheme": "https", "host": "www.iesdouyin.com" },
              { "scheme": "https", "host": "instagram.com" },
              { "scheme": "https", "host": "www.instagram.com" },
              { "scheme": "https", "host": "instagr.am" },
              { "scheme": "https", "host": "x.com" },
              { "scheme": "https", "host": "twitter.com" },
              { "scheme": "https", "host": "t.co" },
              { "scheme": "https", "host": "tiktok.com" },
              { "scheme": "https", "host": "www.tiktok.com" },
              { "scheme": "https", "host": "vm.tiktok.com" }
            ]
          }
        ]
      }
    ]
  }
}
